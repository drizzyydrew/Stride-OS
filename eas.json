{
  "cli": { "version": ">= 12.0.0", "appVersionSource": "local" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": { "buildType": "apk" }
    },
    "production": {
      "environment": "production",
      "ios": { "image": "macos-tahoe-26.5-xcode-26.6" }
    },
    "billing-qa": {
      "extends": "production",
      "distribution": "store",
      "env": { "EXPO_PUBLIC_STRIDEOS_BILLING_ENABLED": "true" }
    },
    "capture-sim": {
      "extends": "production",
      "developmentClient": false,
      "env": { "EXPO_PUBLIC_STRIDEOS_BILLING_ENABLED": "false" },
      "ios": {
        "simulator": true,
        "buildConfiguration": "Release",
        "resourceClass": "medium",
        "autoIncrement": false
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6782788130"
      }
    }
  }
}
