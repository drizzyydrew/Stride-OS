<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>CFBundleDisplayName</key>
    <string>StrideOS</string>
    <key>CFBundleIconFiles</key>
    <array>
      <string>AppIcon</string>
    </array>
    <key>CFBundleIconName</key>
    <string>AppIcon</string>
    <key>CFBundleIcons</key>
    <dict>
      <key>CFBundlePrimaryIcon</key>
      <dict>
        <key>CFBundleIconFiles</key>
        <array>
          <string>AppIcon</string>
        </array>
        <key>CFBundleIconName</key>
        <string>AppIcon</string>
      </dict>
    </dict>
    <key>NSMotionUsageDescription</key>
    <string>StrideOS reads your current step cadence during workouts.</string>
    <key>NSHealthShareUsageDescription</key>
    <string>StrideOS uses the workout measurements you choose to share, such as heart rate, distance, energy, steps, running metrics, and cycling cadence or power, to record and review your activities.</string>
    <key>NSHealthUpdateUsageDescription</key>
    <string>StrideOS saves completed Apple Watch workouts you record in StrideOS to Apple Health.</string>
    <key>NSLocationWhenInUseUsageDescription</key>
    <string>StrideOS records your route on Apple Watch during outdoor workouts, so your run or hike is mapped even if your iPhone is off.</string>
    <key>UIBackgroundModes</key>
    <array>
      <string>location</string>
    </array>
    <key>WKBackgroundModes</key>
    <array>
      <string>workout-processing</string>
    </array>
    <key>WKApplication</key>
    <true/>
  </dict>
</plist>
