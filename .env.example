EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
EXPO_PUBLIC_STRAVA_CLIENT_ID=your-strava-client-id

# Public ingestion configuration. Opt-in is still required on each account/device.
EXPO_PUBLIC_POSTHOG_API_KEY=
EXPO_PUBLIC_POSTHOG_HOST=
EXPO_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
# Keep SENTRY_AUTH_TOKEN in EAS build secrets, never EXPO_PUBLIC_* or source control.

# Do not put ANTHROPIC_API_KEY in this app file.
# Set it as a Supabase Edge Function secret instead:
# supabase secrets set ANTHROPIC_API_KEY=sk-ant-...
# Optional:
# supabase secrets set ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Do not put STRAVA_CLIENT_SECRET in this app file.
# Set Strava credentials as Supabase Edge Function secrets:
# supabase secrets set STRAVA_CLIENT_ID=your-strava-client-id
# supabase secrets set STRAVA_CLIENT_SECRET=your-strava-client-secret
